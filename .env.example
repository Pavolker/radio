# OPENROUTER_API_KEY: Required for the AI Radio DJ Host (OpenRouter).
# Get your key at https://openrouter.ai/keys
# If not set, the host uses a fallback message template.
OPENROUTER_API_KEY=""

# OPENROUTER_MODEL: Model used for the AI Radio DJ Host.
# Default: meta-llama/llama-3.3-70b-instruct (free tier)
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct"
